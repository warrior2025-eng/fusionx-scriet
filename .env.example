# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — server only, never expose to the client.
# Used only by lib/supabase/server.ts#createAdminClient for trusted
# server-side operations. Keep this out of any NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for metadata and password-reset redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email for notifications (optional). Without these two, nothing is emailed
# and notifications stay on the site only. Server only: never NEXT_PUBLIC_.
# RESEND_API_KEY comes from https://resend.com (API Keys); EMAIL_FROM must use
# a domain verified there, e.g. FusionX@SCRIET <notifications@fxscriet.com>
RESEND_API_KEY=
EMAIL_FROM=

# FusionX Interview Room (optional; days stay on Google Meet without it).
# From https://cloud.livekit.io (free Build plan, no card): Settings → Keys.
# LIVEKIT_URL is the project URL (wss://…livekit.cloud); the browser connects
# to it, so it is not secret. The key and secret are server only: never NEXT_PUBLIC_.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
